summa=0
from random import*
arve="Toode Kogus Hind Kokku\n"
valik=input("Kas soovid osta piima? jah/ei: ")
if valik.lower()=="jah" :
    kogus=input("Mitu: ")
    if kogus.isdigit():
        kogus=int(kogus)
        p_hind=round(uniform(0.5,3),2)
        print("Piima hind on {p_hind}")
        arve+=f"piim {kogus} {p_hind}£ {round(kogus*p_hind,2)}£\n"
        summa+=kogus*p_hind
    else:
        print("Viga: vale kogus")
else:
    print("Selge: piima ei taha")
valik=input("Kas soovid osta sai? jah/ei: ")
if valik.lower()=="jah" :
    kogus=input("Mitu: ")
    if kogus.isdigit():
        kogus=int(kogus)
        p_hind=(uniform(0.7,3),2)
        print("Sai hind on {p_hind}")
        arve+=f"piim {kogus} {p_hind}£ {round(kogus*p_hind,2)} £\n"
        summa+=kogus*p_hind
    else:
        print("Viga: vale kogus")
else:
    print("Selge: saia ei taha")
print("Arve nr: 000000000")
print(arve)
print(f"Kokku: {summa}£")
