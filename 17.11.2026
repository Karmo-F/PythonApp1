tehed=["+", "-", "*", "/"]
try:
    arv1=float(input("Sisestage arv üks"))
    arv2=float(input("Sisestage arv kaks"))
    tehe=input("Sisestage tehe: ")
    if tehe in tehed:
        if tehe=="+":
            print(f"{arv1}{tehe}{arv2}={arv1+arv2}")
        elif tehe=="-":
            print(f"{arv1}{tehe}{arv2}={arv1-arv2}")
        elif tehe=="*":
            print(f"{arv1}{tehe}{arv2}={arv1*arv2}")
        elif tehe=="/":
            if arv2==0:
                print("DIV/0")
            else:
                print(f"{arv1}{tehe}{arv2}={arv1/arv2}")
    else:
        print("Tundmatu tehtemärk")
except ValueError:
    print("Viga: sisestage arvud")
